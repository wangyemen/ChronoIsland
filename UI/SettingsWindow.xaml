<Window x:Class="ChronoIsland.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时序岛 · 设置"
        Width="880" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource WindowSurface}"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <!-- 注意：不在此处合并 Theme.xaml —— 颜色 token 由 App 级提供，
                 窗口级同名资源会遮蔽 App 级，导致主题切换失效。 -->

            <!-- 侧边栏导航项 -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="10" Padding="11,9" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSurface}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#296AA2FF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#526AA2FF"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>

            <!-- 设置行 -->
            <Style x:Key="Row" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource RowSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 分组卡 -->
            <Style x:Key="Group" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <Style x:Key="H" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="Lb" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- 胶囊开关 -->
            <Style x:Key="Toggle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Width="46" Height="26">
                                <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource Track}"
                                        BorderBrush="{DynamicResource Stroke}" BorderThickness="1"/>
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KX" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                    <Setter TargetName="Track" Property="BorderThickness" Value="0"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KX" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KX" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Pill" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource RowSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PillPrimary" TargetType="Button" BasedOn="{StaticResource Pill}">
                <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 实心窗口：无圆角、无投影，层次靠表面明度差 -->
    <Border x:Name="RootCard" CornerRadius="0" Margin="0"
            Background="{DynamicResource WindowSurface}">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="CardY" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧导航 ===== -->
            <Border Grid.Column="0" Background="{DynamicResource PanelSurface}"
                    BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 品牌 -->
                    <Border Grid.Row="0" Padding="16,16,14,12"
                            BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_Down">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="26" Height="26" Margin="0,0,10,0">
                                <Ellipse x:Name="FallbackDot" Width="22" Height="22"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentGradient}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#5E9BFF" BlurRadius="10" Opacity="0.7" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Image x:Name="TitleIcon" Width="26" Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="时序岛" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="VerText" Text="ChronoIsland v0.0.1"
                                           FontSize="10" Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 导航列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,12">
                        <StackPanel>
                            <TextBlock Text="概览" FontSize="10" Foreground="{DynamicResource TextTertiary}"
                                       Margin="11,0,0,6"/>
                            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NavItem}"
                                     SelectionChanged="Nav_Changed">
                                <ListBoxItem Tag="general">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="常规" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="about">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="关于" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <TextBlock Text="功能" FontSize="10" Foreground="{DynamicResource TextTertiary}"
                                       Margin="11,14,0,6"/>
                            <ListBox x:Name="NavFunc" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NavItem}"
                                     SelectionChanged="Nav_Changed">
                                <ListBoxItem Tag="clock">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="时间日期" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="usage">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="使用时长" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="media">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="媒体控制" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="notify">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Width="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="通知接管" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="NotifyBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource Danger}" CornerRadius="8"
                                                Padding="6,1" Visibility="Collapsed">
                                            <TextBlock x:Name="NotifyBadgeText" Text="!" FontSize="10"
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="sys">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="系统状态" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="power">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="电源与电池" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="network">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="无线与网络" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="mic">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="麦克风" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="dsh">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="DeepSeek Harness" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <TextBlock Text="外观" FontSize="10" Foreground="{DynamicResource TextTertiary}"
                                       Margin="11,14,0,6"/>
                            <ListBox x:Name="NavLook" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NavItem}"
                                     SelectionChanged="Nav_Changed">
                                <ListBoxItem Tag="theme">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="主题与材质" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="anim">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="动画" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="themeSwitch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Width="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="外观切换提示" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 右侧内容 ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Padding="22,18,16,14"
                        BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_Down">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="常规" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="PageSub" Text="" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>
                        <Button x:Name="BtnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Cursor="Hand" Click="BtnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="16" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Chip}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 页面内容 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                    <ContentControl x:Name="PageHost"/>
                </ScrollViewer>

                <!-- 底部 -->
                <Border Grid.Row="2" Padding="22,12"
                        BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="StatusText" Text="v0.0.1 dev" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="预览灵动岛" Style="{StaticResource Pill}" Click="BtnPreview_Click"/>
                            <Button Content="恢复默认" Style="{StaticResource Pill}" Margin="8,0,0,0" Click="BtnReset_Click"/>
                            <Button Content="保存" Style="{StaticResource PillPrimary}" Margin="8,0,0,0" Click="BtnSave_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
