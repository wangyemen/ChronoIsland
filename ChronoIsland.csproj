<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>ChronoIsland.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8305</NoWarn>
    <!-- 版本号：与仓库根目录 version.txt 第一行保持一致，供自动更新比对 -->
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.174" PrivateAssets="all" />
    <PackageReference Include="Lyricify.Lyrics.Helper" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 图标资源：assets\icon.ico 由用户放置，缺失时回退内置矢量图标 -->
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lucide 矢量图标（ISC）：嵌入程序集，运行时由 Native\SvgIcons 解析 -->
    <EmbeddedResource Include="Assets\Icons\*.svg">
      <LogicalName>ChronoIsland.Assets.Icones.%(Filename).svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
