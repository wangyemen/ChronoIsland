<Application x:Class="ChronoIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 样式（不含颜色）：Toggle / Pill / NavItem / Group / Row ... -->
                <ResourceDictionary Source="UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 主题 token（由 App.ApplyTheme 在运行时整体覆盖）===== -->
            <!-- 三层表面：窗口底 / 分组卡 / 设置行 -->
            <SolidColorBrush x:Key="WindowSurface" Color="#FF101016"/>
            <SolidColorBrush x:Key="PanelSurface" Color="#FF1A1A23"/>
            <SolidColorBrush x:Key="RowSurface" Color="#FF24242F"/>
            <SolidColorBrush x:Key="Track" Color="#FF2C2C38"/>
            <SolidColorBrush x:Key="Stroke" Color="#FF2E2E3A"/>
            <SolidColorBrush x:Key="StrokeStrong" Color="#FF3A3A48"/>
            <SolidColorBrush x:Key="Separator" Color="#FF26262F"/>
            <!-- 岛本体 -->
            <SolidColorBrush x:Key="IslandTop" Color="#FF1C1C25"/>
            <SolidColorBrush x:Key="IslandBottom" Color="#FF0E0E13"/>

            <!-- 文字 -->
            <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F6F8"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#FFA8ADB7"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#FF767C8A"/>
            <!-- 兼容旧 key -->
            <SolidColorBrush x:Key="Chip" Color="#FF24242F"/>

            <!-- 强调与语义 -->
            <SolidColorBrush x:Key="Accent" Color="#FF5E9BFF"/>
            <SolidColorBrush x:Key="Accent2" Color="#FFB27BFF"/>
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5E9BFF" Offset="0"/>
                <GradientStop Color="#FFB27BFF" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Success" Color="#FF3DDC97"/>
            <SolidColorBrush x:Key="Warning" Color="#FFFFC75A"/>
            <SolidColorBrush x:Key="Danger" Color="#FFFF6B6B"/>
            <SolidColorBrush x:Key="Surface" Color="#FF101016"/>
            <SolidColorBrush x:Key="SurfaceElevated" Color="#FF1A1A23"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
